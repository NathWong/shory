{% extends 'base.html.twig' %}
{% import 'helpers/right_menu_helper.html.twig' as menuHelper %}
{% import 'helpers/story_helper.html.twig' as storyHelper %}

{% set storyGroup = story.storyGroup %}

{% block target_center_turbo %}
    <div class="text-center">
        <a href="{{ path('app_story_index') }}"
           class="btn btn-outline-secondary"
           data-turbo-frame="target-center"
           data-turbo-action="advance"
        >
            <i class="bi bi-arrow-left-circle me-2"></i>
            Back to stories list
        </a>
    </div>
    <div class="my-5 col-lg-9 col-xl-8 mx-auto">

        <div class="pb-3 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h1 class="display-5 fw-bold mb-0">{{ storyGroup.Title }}</h1>

                <div class="d-flex align-items-center">
                    {% if app.user and app.user.userProfile == storyGroup.owner %}
                        <a href="{{ path('app_story_edit', {'id': story.id}) }}"
                           class="btn btn-secondary"
                           data-turbo-frame="target-center"
                        >
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                    {% endif %}
                </div>
            </div>
            <p class="lead text-muted">{{ story.Summary }}</p>
            <p class="small text-muted">
                By : {{ storyGroup.owner.penName ? storyGroup.owner.penName : storyGroup.owner.firstName }} |
                Create at : {{ story.createdAt|date('d M Y') }}
            </p>
            {{ storyHelper.genre_tag(story) }}
            <div class="d-flex align-items-center mb-2">
                <span class="me-2">Template :</span>
                <span class="badge rounded-pill fs-6 fw-normal {{ template.getCssClass }}">
                            {{ template.getName }}
                            <small class="fst-italic opacity-75">{{ template.getDescription }}</small>
                        </span>
            </div>
            <div class="d-flex align-items-center">
                <span class="me-2">Status :</span>
                <span class="badge rounded-pill fs-6 fw-normal {{ story.storyStatus.getColorClass() }}">
                    {{ story.storyStatus.value|capitalize }}
                </span>

                {% if app.user and app.user.userProfile == storyGroup.owner and story.storyStatus.value == 'draft' %}
                    {{ form_start(form, {'action': path('app_story_request_publish', {'id': story.id}), 'method': 'POST', 'attr': {'data-turbo': 'true', 'data-turbo-confirm': 'Are you sure you want to submit this story for validation? It will be locked until a moderator reviews it.'}}) }}
                        <button type="submit" class="btn btn-success btn-sm ms-3">
                            <i class="bi bi-send"></i> Request Publication
                        </button>
                    {{ form_end(form) }}
                {% endif %}
            </div>
        </div>

        <hr class="my-4">

        {# --- Moderation Messages --- #}
        {% if moderationMessages is not empty %}
            <div class="mb-4">
                <h2 class="h4">Moderation History</h2>
                <div class="list-group">
                    {% for message in moderationMessages %}
                        <div class="list-group-item list-group-item-action flex-column align-items-start">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">From: {{ message.sender.userProfile.firstName }} ({{ message.sender.roles|join(', ') }})</h5>
                                <small class="text-muted">{{ message.createdAt|date('d M Y H:i') }}</small>
                            </div>
                            <p class="mb-1">{{ message.message }}</p>
                            <small class="text-muted">To: {{ message.receiver.userProfile.firstName }}</small>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <hr class="my-4">
        {% endif %}

        {# --- Chapters --- #}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4">Chapitres</h2>
            {% if app.user and app.user.userProfile == storyGroup.owner %}
                <a href="{{ path('app_chapter_new', {'story_id': story.id}) }}"
                   class="btn btn-outline-primary btn-sm"
                   data-turbo-frame="target-center"
                >
                    <i class="bi bi-plus-circle"></i> New chapter
                </a>
            {% endif %}
        </div>

        <div class="list-group list-group-flush">
            {% for chapter in story.chapters %}
                <a href="{{ path('app_chapter_show', {'id': chapter.id}) }}"
                   class="list-group-item list-group-item-action py-3"
                   data-turbo-frame="target-center"
                   data-turbo-action="advance"
                >
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">
                            {{ chapter.title }}
                            {% if story.beginning and story.beginning.id == chapter.id %}
                                <span class="badge badge-beginning ms-3">Beginning</span>
                            {% endif %}
                        </h5>
                        <small class="text-muted">Last update {{ chapter.updatedAt|date('d M Y') }}</small>
                    </div>
                </a>
            {% else %}
                <div class="list-group-item text-center p-5">
                    {% if app.user and app.user.userProfile == storyGroup.owner %}
                        <h5 class="mb-3">The first page is blank.</h5>
                        <p class="text-muted mb-4">Every great adventure begins with a single chapter. Let's write yours.</p>
                        <a href="{{ path('app_chapter_new', {'story_id': story.id}) }}"
                           class="btn btn-primary"
                           data-turbo-frame="target-center"
                        >
                            <i class="bi bi-pen-fill me-2"></i>Write the first chapter
                        </a>
                    {% else %}
                        <p class="text-muted">No chapters have been written for this story yet. Check back soon!</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
