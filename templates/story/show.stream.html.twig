{% extends 'base_stream.html.twig' %}
{% import 'helpers/right_menu_helper.html.twig' as menuHelper %}

{% block template_center %}
    <h1>{{ story.Title }}</h1>
    <p>{{ story.Summary }}</p>
{% endblock %}

{% block template_right %}
    {% set list %}
        {% for chapter in chapters %}
            {{ menuHelper.list_item(
                path('app_chapter_show', {'id': chapter.id}),
                'bi bi-book',
                chapter.title
            ) }}
        {% endfor %}
        {{ menuHelper.list_separator() }}
        {{ menuHelper.list_item(
            path('app_chapter_new', {'story_id': story.id}),
            'bi bi-plus-circle-fill',
            'New chapter'
        ) }}
    {% endset %}
    {{ menuHelper.list_formater('Chapters', list) }}
{% endblock %}
