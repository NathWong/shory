<turbo-stream action="update" target="target-center">
    <template>
        <h1>{{ story.Title }}</h1>
        <p>{{ story.Summary }}</p>
    </template>
</turbo-stream>

<turbo-stream action="update" target="target-right">
    <template>
        <ul>{% dump story %}
            <li>
                <a data-frame-turbo="target-center"
                   href="{{ path('app_chapter_new', {'story_id': story.id}) }}"
                >
                    New chapter
                </a>
            </li>
        </ul>
    </template>
</turbo-stream>
