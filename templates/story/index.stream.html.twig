{% extends 'base_stream.html.twig' %}

{% block template_center %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>My Stories</h1>
            <a href="{{ path('app_story_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>New Story
            </a>
        </div>

        {# --- Filters --- #}
        <form action="{{ path('app_story_index') }}"
              method="get"
              {{ stimulus_controller('auto-submit') }}
              data-turbo-frame="stories-list">
            <div class="row g-2 mb-4">
                <div class="col-md-8">
                    <input type="text"
                           name="q"
                           class="form-control"
                           placeholder="Search by title..."
                           value="{{ searchTerm }}"
                           {{ stimulus_action('auto-submit','submit', 'input') }}
                    >
                </div>
                <div class="col-md-4">
                    <select name="sort" class="form-select" {{ stimulus_action('auto-submit','submit', 'change') }}>
                        <option value="updatedAt" {{ sortBy == 'updatedAt' ? 'selected' }}>Sort by last update</option>
                        <option value="createdAt" {{ sortBy == 'createdAt' ? 'selected' }}>Sort by creation date</option>
                        <option value="title" {{ sortBy == 'title' ? 'selected' }}>Sort by title</option>
                    </select>
                </div>
            </div>
        </form>

        {# --- Stories --- #}
        <turbo-frame id="stories-list">
            <div class="row g-4">
                {% for story in stories %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ story.title }}</h5>
                                <p class="card-text text-muted small">
                                    Created at {{ story.createdAt|date('d/m/Y') }}<br>
                                    Last update {{ story.updatedAt|date('d/m/Y') }}
                                </p>
                                <a href="{{ path('app_story_show', {'id': story.id}) }}"
                                   class="btn btn-outline-secondary mt-auto"
                                   data-turbo-stream=""
                                >
                                    Open
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">No stories found.</div>
                    </div>
                {% endfor %}
            </div>
        </turbo-frame>
    </div>
{% endblock %}
