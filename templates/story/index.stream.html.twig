{% extends 'base_stream.html.twig' %}

{% block template_center %}
    <table>
        <thead>
            <th>Title</th>
            <th>Last update</th>
            <th>Created at</th>
        </thead>
        <tbody>
        {% for story in stories %}
            <tr>
                <td>
                    <a href="{{ path('app_story_show', {'id': story.id}) }}"
                       data-turbo-stream=""
                    >
                        {{ story.title }}
                    </a>
                </td>
                <td>
                    {{ story.updatedAt|date("m/d/Y") }}
                </td>
                <td>
                    {{ story.createdAt|date("m/d/Y") }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
