{% extends 'base.html.twig' %}
{% import 'helpers/story_helper.html.twig' as storyHelper %}
{% import 'helpers/global_helper.html.twig' as helper %}

{% block target_center_turbo %}
    {{ helper.back_button(
        'Back to home',
        path('app_home')
    ) }}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>My Stories</h1>
            <a href="{{ path('app_story_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>New Story
            </a>
        </div>

        {# --- Filters --- #}
        <form action="{{ path('app_story_index') }}"
              method="get"
              {{ stimulus_controller('auto-submit') }}
              data-turbo-frame="stories-list">
            <div class="row g-2 mb-4">
                <div class="col-md-8">
                    <label for="story-search" class="visually-hidden">Search by title...</label>
                    <input type="text"
                           name="q"
                           id="story-search"
                           class="form-control"
                           placeholder="Search by title..."
                           value="{{ searchTerm }}"
                           {{ stimulus_action('auto-submit','submit', 'input') }}
                    >
                </div>
                <div class="col-md-4">
                    <label for="story-sort" class="visually-hidden">Sort by</label>
                    <select name="sort"
                            id="story-sort"
                            class="form-select"
                            {{ stimulus_action('auto-submit','submit', 'change') }}
                    >
                        <option value="updatedAt" {{ sortBy == 'updatedAt' ? 'selected' }}>Sort by last update</option>
                        <option value="createdAt" {{ sortBy == 'createdAt' ? 'selected' }}>Sort by creation date</option>
                        <option value="title" {{ sortBy == 'title' ? 'selected' }}>Sort by title</option>
                    </select>
                </div>
            </div>
        </form>

        {# --- Stories --- #}
        <turbo-frame id="stories-list">
            <div class="row g-4">
                {% for storyGroup in storyGroups %}
                    {% set story = storyGroup.getLastStory %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm story-render-container position-relative {{ templateManager.getTemplateClass(story) }}">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ storyGroup.title }}</h5>
                                {% if storyGroup.isPublished() %}
                                    <div class="published_stamp">
                                        <strong>Published</strong>
                                    </div>
                                {% endif %}
                                {{ storyHelper.genre_tag(storyGroup) }}
                                <p class="card-text text-muted small">
                                    Created at {{ story.createdAt|date('d/m/Y') }}<br>
                                    Last update {{ story.updatedAt|date('d/m/Y') }}
                                </p>
                                <a href="{{ path('app_story_show', {'id': story.id}) }}"
                                   class="btn btn-outline-secondary mt-auto"
                                   data-turbo-frame="target-center"
                                   data-turbo-action="advance"
                                >
                                    Open
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">No stories found.</div>
                    </div>
                {% endfor %}
            </div>
        </turbo-frame>
    </div>
{% endblock %}
