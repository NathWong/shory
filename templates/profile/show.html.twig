{% extends 'base.html.twig' %}

{% block target_center_turbo %}
    <div class="container my-5">

        <div class="p-4 p-md-5 rounded-3 bg-body-tertiary">
            <div class="row align-items-center">

                {# --- Left column : Avatar --- #}
                <div class="col-lg-4 text-center mb-4 mb-lg-0">
                    {% if user_profile.avatar %}
                        <img src="{{ asset('uploads/avatars/' ~ user_profile.avatar) }}"
                             alt="Avatar de {{ user_profile.firstName }}"
                             class="img-fluid rounded-circle shadow-sm"
                             style="max-width: 180px;">
                    {% else %}
                        <div class="p-4 bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 180px; height: 180px;">
                            <i class="bi bi-person-fill" style="font-size: 5rem; color: #6c757d;"></i>
                        </div>
                        <div class="mt-3">
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary btn-sm">
                                Upload
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# --- Right column : Informations --- #}
                <div class="col-lg-8">
                    <h1 class="display-5 fw-bold">{{ user_profile.firstName }} {{ user_profile.lastName }}</h1>
                    {% if user_profile.penName %}
                        <p class="lead text-muted">"{{ user_profile.penName }}"</p>
                    {% endif %}

                    <hr class="my-4">

                    <dl class="row fs-5">
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">{{ app.user.email }}</dd>

                        <dt class="col-sm-3">Rang</dt>
                        <dd class="col-sm-9">
                            <span class="badge text-bg-info fs-6">{{ user_profile.rank }}</span>
                        </dd>
                    </dl>

                    {# Action button #}
                    <div class="d-flex gap-2 mt-4">
                        <a href="{{ path('app_profile_edit', {'id': user_profile.id}) }}" class="btn btn-secondary">Modifier le profil</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
