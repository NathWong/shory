{% extends 'base.html.twig' %}

{% block target_center_turbo %}
    <h1>Account informations</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ user_profile.id }}</td>
        </tr>
        <tr>
            <th>FirstName</th>
            <td>{{ user_profile.firstName }}</td>
        </tr>
        <tr>
            <th>LastName</th>
            <td>{{ user_profile.lastName }}</td>
        </tr>
        <tr>
            <th>PenName</th>
            <td>{{ user_profile.penName }}</td>
        </tr>
        <tr>
            <th>Avatar</th>
            <td>{{ user_profile.avatar }}</td>
        </tr>
        <tr>
            <th>Rank</th>
            <td>{{ user_profile.rank }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_profile_index') }}">back to list</a>

    <a href="{{ path('app_profile_edit', {'id': user_profile.id}) }}">edit</a>

    {{ include('profile/_delete_form.html.twig') }}
{% endblock %}
