{% macro toolbar_button(title, content, wrapper) %}
    <button type="button" class="btn btn-sm btn-light"
            title="{{ title | trans }}"
        {{ stimulus_action('markdown_editor', 'wrapSelection') }}
            data-pattern="{{ wrapper }}"
    >{{ content | raw }}</button>
{% endmacro %}

{% macro toolbar() %}
    <div class="btn-toolbar p-2 border-bottom bg-light rounded-top" role="toolbar">
        <div class="btn-group me-2" role="group">
            {{ _self.toolbar_button('Bold', '<i class="bi bi-type-bold"></i>', '**%%text**') }}
            {{ _self.toolbar_button('Italic', '<i class="bi bi-type-italic"></i>', '_%%text%%_') }}
            <div class="vr mx-2"></div>
            {{ _self.toolbar_button('Title 1', '<i class="bi bi-type-h1"></i>', '# %%text%%') }}
            {{ _self.toolbar_button('Title 2', '<i class="bi bi-type-h2"></i>', '## %%text%%') }}
            <div class="vr mx-2"></div>
            {{ _self.toolbar_button('Quote', '<i class="bi bi-type-quote"></i>', '> %%text%%') }}
            {{ _self.toolbar_button('List', '<i class="bi bi-type-ul"></i>', '* %%text%%') }}
        </div>
        <div class="btn-group ms-auto" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                {{ stimulus_action('markdown_editor', 'edit') }}
                {{ stimulus_target('markdown_editor', 'editButton') }}
            >Edit</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                {{ stimulus_action('markdown_editor', 'preview') }}
                {{ stimulus_target('markdown_editor', 'previewButton') }}
            >Preview</button>
        </div>
    </div>
{% endmacro %}

{% macro editor(form_field) %}
    <div class="border rounded-3 mb-4" {{ stimulus_controller('markdown_editor') }}>
        {{ _self.toolbar() }}
        {{ form_widget(form_field, {'attr': {'class': 'form-control border-0', 'data-markdown_editor-target': 'content'}}) }}
        <div class="p-3 prose" {{ stimulus_target('markdown_editor', 'preview') }} style="display: none;"></div>
    </div>
{% endmacro %}
