{% macro burger_list(content, link, target = 'target-center') %}
    <li class="nav-item">
        <a class="nav-link"
           href="{{ path(link) }}"
           data-turbo-frame= "{{ target }}"
           data-turbo-stream=""
            {{ stimulus_action('offcanvas-closer', 'close', 'click') }}
        >
            {{ content | trans }}
        </a>
    </li>
{% endmacro %}
