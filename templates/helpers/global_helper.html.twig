{% macro burger_list(content, link, target = 'target-center') %}
    <li class="nav-item">
        <a class="nav-link"
           href="{{ path(link) }}"
           data-turbo-frame= "{{ target }}"
           data-turbo-stream=""
            {{ stimulus_action('offcanvas-closer', 'close', 'click') }}
        >
            {{ content | trans }}
        </a>
    </li>
{% endmacro %}

{% macro widget_card(title, description, link_path, link_text) %}
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{ title | raw }}</h5>
                <p class="card-text text-muted">{{ description }}</p>
                <a href="{{ link_path }}" class="btn btn-primary mt-auto" data-turbo-stream="">{{ link_text }}</a>
            </div>
        </div>
    </div>
{% endmacro %}
