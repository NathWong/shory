{% extends 'base.html.twig' %}
{% import "helpers/global_helper.html.twig" as helper %}

{% block target_center_turbo %}
    {{ helper.back_button(
        'Back to story',
        path('app_story_show', {'id': story.id})
    ) }}
    <div class="my-4 story-render-container col-lg-9 col-xl-8 mx-auto {{ template_class }}">

        {# --- Chapter Title --- #}
        <div class="pb-3 mb-4 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5 fw-bold">{{ chapter.title }}</h1>

                {# Edit only if  #}
                {% if app.user and app.user.userProfile == chapter.story.storyGroup.owner %}
                    <a href="{{ path('app_chapter_edit', {'id': chapter.id}) }}"
                       class="btn btn-secondary"
                       data-turbo-frame="target-center"
                    >Edit</a>
                {% endif %}
            </div>

            <p class="text-muted small">
                Created on {{ chapter.createdAt|date('d F Y') }}
                {% if chapter.updatedAt != chapter.createdAt %}
                    - Updated on {{ chapter.updatedAt|date('d F Y') }}
                {% endif %}
            </p>
        </div>

        <div class="chapter-content fs-5">
            {{ chapter.content | sanitize_html('app.hard') | markdown_to_html | sanitize_html('app.chapter_content') | raw }}
        </div>

        <div class="card mb-3">
            <div class="card-body">
                {{ include(link_twig, {'chapter_links': chapter.chapterLinks, 'route': 'show'}) }}
            </div>
        </div>

    </div>
{% endblock %}
