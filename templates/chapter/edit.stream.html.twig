{% extends 'story/show.stream.html.twig' %}
{% import 'helpers/markdown_helper.html.twig' as mkd  %}

{% block template_center %}
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">

                <h1 class="mb-4">Edit Chapter</h1>
                {{ form_start(form, {'action': path('app_chapter_edit', {'id': chapter.id})}) }}

                <div class="form-floating mb-3">
                    {{ form_widget(form.title) }}
                    {{ form_label(form.title) }}
                </div>

                <div class="border rounded-3 mb-4" {{ stimulus_controller('markdown_editor') }}>
                    {# Tool bar #}
                    <div class="btn-toolbar p-2 border-bottom bg-light rounded-top" role="toolbar">
                        <div class="btn-group me-2" role="group">
                            {{ mkd.toolbar_button('Bold', '<i class="bi bi-type-bold"></i>', '**%%text**') }}
                            {{ mkd.toolbar_button('Italic', '<i class="bi bi-type-italic"></i>', '_%%text%%_') }}
                            <div class="vr mx-2"></div>
                            {{ mkd.toolbar_button('Title 1', '<i class="bi bi-type-h1"></i>', '# %%text%%') }}
                            {{ mkd.toolbar_button('Title 2', '<i class="bi bi-type-h2"></i>', '## %%text%%') }}
                            <div class="vr mx-2"></div>
                            {{ mkd.toolbar_button('Quote', '<i class="bi bi-type-quote"></i>', '> %%text%%') }}
                            {{ mkd.toolbar_button('List', '<i class="bi bi-type-ul"></i>', '* %%text%%') }}
                        </div>
                        <div class="btn-group ms-auto" role="group">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                {{ stimulus_action('markdown_editor', 'edit') }}
                                {{ stimulus_target('markdown_editor', 'editButton') }}
                            >Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                {{ stimulus_action('markdown_editor', 'preview') }}
                                {{ stimulus_target('markdown_editor', 'previewButton') }}
                            >Preview</button>
                        </div>
                    </div>

                    {{ form_widget(form.content, {'attr': {'class': 'form-control border-0'}}) }}

                    <div class="p-3 prose" {{ stimulus_target('markdown_editor', 'preview') }} style="display: none;"></div>
                </div>

                <div class="form-floating mb-3">
                    {{ form_widget(form.linkType) }}
                    {{ form_label(form.linkType) }}
                </div>

                <div class="my-4 p-3 border rounded-3 bg-body-tertiary" {{ stimulus_controller('form_collection') }}>
                    {{ form_label(form.chapterLinks) }}

                    <div {{ stimulus_target('form_collection', 'collectionContainer') }}
                         data-prototype="{{ include('chapter/_chapter_link_form.html.twig', {linkForm: form.chapterLinks.vars.prototype})|e('html_attr')}}">

                        {% for linkForm in form.chapterLinks %}
                            {{ include('chapter/_chapter_link_form.html.twig', {linkForm: linkForm}) }}
                        {% endfor %}
                    </div>

                    <button type="button" class="btn btn-secondary btn-sm mt-2" data-action="click->form-collection#add"
                            data-turbo-stream="">
                        Add link
                    </button>
                </div>

                <div class="d-flex justify-content-end align-items-center mt-4">
                    <a href="{{ path('app_chapter_show', {'id': chapter.id}) }}" class="btn btn-secondary me-3" data-turbo-stream="">
                        Cancel
                    </a>

                    <button class="btn btn-primary btn-lg" data-turbo-stream="">{{ button_label|default('Save modifications') }}</button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
