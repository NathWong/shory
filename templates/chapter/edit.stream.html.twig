{% extends 'base_stream.html.twig' %}

{% block template_center %}
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">

                <h1 class="mb-4">Edit Chapter</h1>
                {{ form_start(form, {'action': path('app_chapter_edit', {'id': chapter.id})}) }}

                <div class="mb-3">
                    {{ form_row(form.title) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.content) }}
                </div>

                <div class="d-flex justify-content-end align-items-center mt-4">
                    <a href="{{ path('app_chapter_show', {'id': chapter.id}) }}" class="btn btn-secondary me-3" data-turbo-stream="">
                        Cancel
                    </a>

                    <button class="btn btn-primary btn-lg" data-turbo-stream="">{{ button_label|default('Save modifications') }}</button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
