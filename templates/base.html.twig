<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Shory{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column vh-100">
        {% block body %}
        {# ----- Up toolbar ----- #}
            <header>
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
                    <div class="container-fluid">

                        {# 1. logo - link to home #}
                        <a class="navbar-brand mx-auto" href="{{ path('app_home_index') }}">
                            <img src="{{ asset('images/logo.png') }}" alt="Logo de Shory" height="30">
                        </a>

                        {# 2. Burger button for mobile #}
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        {# 3. right burger menu #}
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                                {% if app.user %}
                                    {# Connected user #}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_profile_user', {'user_id': app.user.id}) }}" data-turbo-frame="target-center">
                                            Mon Profil
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                                    </li>
                                {% else %}
                                    {# Non connected user #}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_login') }}" data-turbo-frame="target-center">
                                            Connexion
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_register') }}" data-turbo-frame="target-center">
                                            Créer un compte
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>

                    </div>
                </nav>
            </header>
            {# ----- Main contener ----- #}
            <div class="d-flex flex-grow-1 overflow-hidden">
                {# ----- Left toolbar ----- #}
                <aside class="p-3 bg-light" style="width: 200px;">
                    <turbo-frame id="target-left">toto
                        {% block target_left %}{% endblock %}
                    </turbo-frame>
                </aside>

                {# Main content #}
                <main class="flex-grow-1 p-4 overflow-auto">
                    <turbo-frame id="target-center">
                        {% block target_center %}{% endblock %}
                    </turbo-frame>
                </main>

                {# ----- Right toolbar ----- #}
                <aside class="p-3 bg-white border-start" style="width: 250px;">
                    <turbo-frame id="target-right">
                        {% block target_right %}{% endblock %}
                    </turbo-frame>
                </aside>
            </div>
        {% endblock %}
    </body>
</html>
