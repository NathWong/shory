<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Shory{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column vh-100">
        {% block body %}
        {# ----- Up toolbar ----- #}
           <header>
                <nav class="navbar bg-light">
                    <div class="container-fluid">
                        <a class="navbar-brand" href="#">Shory</a>
                    </div>
                </nav>
            </header>
            {# ----- Main contener ----- #}
            <div class="d-flex flex-grow-1 overflow-hidden">
                {# ----- Left toolbar ----- #}
                <aside class="p-3 bg-light" style="width: 200px;">
                    <turbo-frame id="target-left">
                        {% block target-left %}{% endblock %}
                    </turbo-frame>
                </aside>

                {# Main content #}
                <main class="flex-grow-1 p-4 overflow-auto">
                    <turbo-frame id="target-center">
                        {% block target-center %}{% endblock %}
                    </turbo-frame>
                </main>

                {# ----- Right toolbar ----- #}
                <aside class="p-3 bg-white border-start" style="width: 250px;">
                    <turbo-frame id="target-right">
                        {% block target-right %}{% endblock %}
                    </turbo-frame>
                </aside>
            </div>
        {% endblock %}
    </body>
</html>
