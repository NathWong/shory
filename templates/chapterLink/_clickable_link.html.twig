<div class="text-center">
    {% for chapter_link in chapter_links %}
        {# @var chapter_link \App\Entity\ChapterLink #}
        {% set border_class = not loop.last ? 'border-bottom' : '' %}
        <div class="py-3 my-2 {{ border_class }}">
            {% if chapter_link.target %}
                {% set target_route = (route == 'read') ? 'app_reading_navigate' : 'app_chapter_show' %}
                {% set attr = (route == 'read') ? chapter_link.id : chapter_link.target.id %}
                <a href="{{ path(target_route, {'id': attr}) }}"
                   class="btn btn-secondary"
                   data-turbo-frame="target-center"
                >{{ chapter_link.responses.response }}</a>
            {% else %}
                <span class="btn btn-outline-danger disabled"
                      {{ stimulus_controller('tooltip') }}
                      data-bs-toggle="tooltip"
                      data-bs-placement="top"
                      title="No targeted chapter found. please add one">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                {{ chapter_link.responses.response }}
            </span>
            {% endif %}
        </div>
    {% endfor %}
</div>
